<Window x:Class="Monarch.Desktop.Central.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MONARCH ERP — Central PostgreSQL" Height="720" Width="1120"
        MinHeight="560" MinWidth="850" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="MONARCH ERP" FontSize="25" FontWeight="Bold" />
        <TextBlock Text="Central PostgreSQL client · Read-only GL validation slice" Foreground="DimGray" />
      </StackPanel>
      <Button x:Name="SignInButton" DockPanel.Dock="Right" Content="Sign in" Width="130" Height="36" Click="SignIn_Click" />
    </DockPanel>
    <Border Grid.Row="1" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="Company" Margin="0,0,0,5" FontWeight="SemiBold" />
          <ComboBox x:Name="CompanyBox" Height="34" IsEnabled="False" SelectionChanged="Company_SelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="Branch" Margin="0,0,0,5" FontWeight="SemiBold" />
          <ComboBox x:Name="BranchBox" Height="34" IsEnabled="False" SelectionChanged="Branch_SelectionChanged" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="2" Text="General Ledger accounts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
    <DataGrid Grid.Row="3" x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Binding="{Binding AccountCode}" Width="150" />
        <DataGridTextColumn Header="Account name" Binding="{Binding AccountName}" Width="*" />
        <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="180" />
        <DataGridTextColumn Header="Normal side" Binding="{Binding NormalSide}" Width="150" />
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Not connected. Configure the required environment variables before signing in." TextWrapping="Wrap" Foreground="DimGray" />
      <Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="Sign out" Width="110" Height="32" IsEnabled="False" Click="SignOut_Click" />
    </DockPanel>
  </Grid>
</Window>
