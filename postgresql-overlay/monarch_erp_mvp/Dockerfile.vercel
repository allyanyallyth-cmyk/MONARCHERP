# Build the .NET 8 ASP.NET Core API from the cumulative MONARCH ERP solution.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/Monarch.Api/Monarch.Api.csproj
RUN dotnet publish src/Monarch.Api/Monarch.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

# Minimal ASP.NET Core runtime image.
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

ENV ASPNETCORE_URLS=http://0.0.0.0:80
ENV ASPNETCORE_HTTP_PORTS=80
EXPOSE 80

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Monarch.Api.dll"]
